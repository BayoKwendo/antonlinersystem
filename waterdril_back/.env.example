# =============================================================================
#  AntonLiner System — backend environment configuration.
#  Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# =============================================================================

# --- HTTP server -------------------------------------------------------------
PORT=5002

# --- Database (MySQL) --------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=waterdril
DB_POOL_SIZE=10

# --- Auth --------------------------------------------------------------------
# Long random string used to sign JWTs. Generate with:
#   deno eval "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=change-me-to-a-long-random-secret
# Short-lived access token; clients refresh with the refresh token.
JWT_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
# Customer OTP (SMS) — code length and validity window.
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# --- CORS --------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (the Vite portal).
# Native apps are not subject to CORS. Defaults to local dev if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Onfon Media SMS gateway -------------------------------------------------
SMS_URL=https://api.onfonmedia.co.ke/v1/sms/SendBulkSMS
SMS_API_KEY=
SMS_SENDER_ID=ANTONLINERS
SMS_CLIENT_ID=
SMS_ACCESS_KEY=

# --- SMTP email (OTP codes + customer invoices) ------------------------------
# Leave EMAIL_HOST empty to disable email delivery (SMS + in-app still work).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=SMART Drill <no-reply@smartdrill.co.ke>
EMAIL_SECURE=false

# --- Safaricom M-Pesa Daraja -------------------------------------------------
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_STK_URL=https://api.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_TOKEN_URL=https://api.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
# MUST be the public HTTPS URL of the stk-callback route (see routes/v1.route.ts) —
# domain only / wrong path means Safaricom's result never reaches the handler and
# payments hang in "pending" silently.
MPESA_CALLBACK_URL=https://api.antonlinersystems.co.ke/api/v1/payments/mpesa/stk-callback

# --- AWS S3 (profile photo uploads) ------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=pantheon2
AWS_S3_REGION=us-east-1

# --- Firebase Cloud Messaging (push) -----------------------------------------
# Service-account JSON for project driller-3a61b (Firebase console ->
# Project settings -> Service accounts -> Generate new private key).
# Supply EITHER the raw JSON inline...
#   FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"driller-3a61b",...}
# ...OR a path to the JSON file (preferred in prod; keep it off the repo):
#   FCM_SERVICE_ACCOUNT_FILE=/etc/secrets/fcm-driller-3a61b.json
# If neither is set, push delivery is disabled (in-app + SMS still work).
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=

# --- Misc --------------------------------------------------------------------
HOTLINE=0111051030
DEFAULT_AVATAR_URL=https://pantheon2.s3.amazonaws.com/1709381936233logo.png
# Public customer-web origin, used to build the /track/:token link in the
# confirmation SMS. Leave empty to omit the link.
WEB_URL=https://smartdrill.co.ke
