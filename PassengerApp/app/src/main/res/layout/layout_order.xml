<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    app:cardElevation="10.0dip">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:backgroundTint="@color/white"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10.0dip"
                android:orientation="vertical">

<!--                <com.fredporciuncula.phonemoji.PhonemojiTextInputLayout-->
<!--                    android:id="@+id/phone_login_Text"-->
<!--                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"-->
<!--                    android:layout_width="fill_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginTop="10.0dip"-->
<!--                    android:hint="Phone number"-->
<!--                    android:visibility="gone"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintTop_toBottomOf="@+id/amount">-->

<!--                    <com.fredporciuncula.phonemoji.PhonemojiTextInputEditText-->
<!--                        android:id="@+id/phone_login"-->
<!--                        android:layout_width="fill_parent"-->
<!--                        android:layout_height="fill_parent"-->
<!--                        android:maxLength="20"-->
<!--                        android:textSize="16.0sp" />-->
<!--                </com.fredporciuncula.phonemoji.PhonemojiTextInputLayout>-->

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/mlocation"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:hint="Your Location (Nairobi/Kisumu etc)"
                    android:inputType="text"
                    android:maxLength="13"
                    android:textSize="20.0sp"
                    android:visibility="gone"
                    app:met_baseColor="@color/purple_700"
                    app:met_floatingLabel="highlight"
                    app:met_primaryColor="@color/purple_700"
                    app:met_singleLineEllipsis="true" />
                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/mphone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:hint="Your Phone Number to use (2547XX)"
                    android:inputType="number"
                    android:maxLength="13"
                    android:textSize="20.0sp"
                    android:visibility="gone"
                    app:met_baseColor="@color/purple_700"
                    app:met_floatingLabel="highlight"
                    app:met_primaryColor="@color/purple_700"
                    app:met_singleLineEllipsis="true" />

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/amount"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Your ID Number"
                    android:inputType="number"
                    android:maxLength="8"
                    android:textSize="20.0sp"
                    android:visibility="gone"
                    app:met_baseColor="@color/purple_700"
                    app:met_floatingLabel="highlight"
                    app:met_primaryColor="@color/purple_700"
                    app:met_singleLineEllipsis="true" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10.0dip"
            android:layout_gravity="center"
            android:gravity="center"
            android:weightSum="1.0">

            <Button
                android:id="@+id/cancel"
                android:layout_width="100.0dip"
                android:layout_height="50.0dip"
                android:layout_weight="0.4"
                android:background="@drawable/button_calculator"
                android:text="CANCEL"
                android:textColor="@color/white" />

            <View
                android:layout_width="20.0dip"
                android:id="@+id/mview"
                android:layout_height="0.0dip" />

            <Button
                android:id="@+id/update"
                android:layout_width="100.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"

                android:background="@drawable/button_calculator"
                android:text="Submit"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>