<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI; this just needs a no-action-bar window theme.
         Framework parent => no AppCompat/Material XML dependency required.
         window_bg resolves to the values-night variant in dark mode, so the
         launch window matches the system theme instead of flashing white. -->
    <style name="Theme.AntonLiner" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Edge-to-edge (targetSdk 35): the Activity calls enableEdgeToEdge() and
             the Compose theme sets the bar icon appearance at runtime. Do NOT set
             android:statusBarColor/navigationBarColor here — they're deprecated in
             API 35, ignored under enforced edge-to-edge, and flagged by Play. -->
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
