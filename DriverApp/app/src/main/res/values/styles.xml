<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI; this just needs a no-action-bar window theme.
         Framework parent => no AppCompat/Material XML dependency required. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#007A7C</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
